  <graph edgedefault="undirected">
    <node id="API LIST ICA DATABASE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">API List ICA Database provides various APIs for retrieving details about food items, ingredients, recipes, customers, and their orders</data>
      <data key="d2">69537a3315fd62e6e0487b8e39b9534d</data>
    </node>
    <node id="PRODUCT">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Product entity used in APIs to query details about food items, including ingredients, nutritional values, allergens, and recipes</data>
      <data key="d2">69537a3315fd62e6e0487b8e39b9534d</data>
    </node>
    <node id="INGREDIENT">
