  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="API LIST ICA DATABASE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">API List ICA Database is a system that provides details about food items, including ingredients, nutritional values, allergens, and recipes</data>
      <data key="d2">3f53abb82c110b676de2943cc5abe6cb</data>
    </node>
    <node id="MUFFIN BURGER">
      <data key="d0">PRODUCT</data>
      <data key="d1">Muffin Burger is a food item that can be queried for details such as ingredients, nutritional values, and allergens</data>
      <data key="d2">3f53abb82c110b676de2943cc5abe6cb</data>
    </node>
    <node id="RECIPE API">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Recipe API is a service that provides recipe details for a given food item ID</data>
      <data key="d2">3f53abb82c110b676de2943cc5abe6cb</data>
    </node>
    <node id="FOOD ITEM">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">A general term for any item of food that can be queried using the API List ICA Database</data>
      <data key="d2">3f53abb82c110b676de2943cc5abe6cb</data>
    </node>
    <node id="PRODUCT QUERY API">
      <data key="d0" />
      <data key="d1" />
      <data key="d2">3f53abb82c110b676de2943cc5abe6cb</data>
    </node>
    <edge source="API LIST ICA DATABASE" target="RECIPE API">
      <data key="d3">1.0</data>
      <data key="d4">The Recipe API is part of the API List ICA Database and provides recipe details for food items</data>
      <data key="d5">3f53abb82c110b676de2943cc5abe6cb</data>
    </edge>
    <edge source="API LIST ICA DATABASE" target="MUFFIN BURGER">
      <data key="d3">1.0</data>
      <data key="d4">The API List ICA Database can provide details about the Muffin Burger</data>
      <data key="d5">3f53abb82c110b676de2943cc5abe6cb</data>
    </edge>
    <edge source="API LIST ICA DATABASE" target="PRODUCT QUERY API">
      <data key="d3">1.0</data>
      <data key="d4">The Product Query API is part of the API List ICA Database and provides details about food items</data>
      <data key="d5">3f53abb82c110b676de2943cc5abe6cb</data>
    </edge>
    <edge source="MUFFIN BURGER" target="PRODUCT QUERY API">
      <data key="d3">1.0</data>
      <data key="d4">The Product Query API can provide details about the Muffin Burger</data>
      <data key="d5">3f53abb82c110b676de2943cc5abe6cb</data>
    </edge>
    <edge source="RECIPE API" target="FOOD ITEM">
      <data key="d3">1.0</data>
      <data key="d4">The Recipe API provides recipe details for various food items</data>
      <data key="d5">3f53abb82c110b676de2943cc5abe6cb</data>
    </edge>
