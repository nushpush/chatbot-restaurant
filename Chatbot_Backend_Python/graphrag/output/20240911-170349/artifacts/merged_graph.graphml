  <graph edgedefault="undirected">
    <node id="API LIST ICA DATABASE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">API List ICA Database is a collection of APIs designed to provide various details about food items, ingredients, customers, and orders</data>
      <data key="d2">c7e00c6a54b81fe33fb8626ede16629e</data>
    </node>
    <node id="PRODUCT">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Product entity in the API List ICA Database, used to query details about food items such as ingredients, nutritional values, allergens, and recipes</data>
      <data key="d2">c7e00c6a54b81fe33fb8626ede16629e</data>
    </node>
    <node id="INGREDIENT">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Ingredient entity in the API List ICA Database, used to query details about ingredients such as unit of measurement and storage</data>
      <data key="d2">c7e00c6a54b81fe33fb8626ede16629e</data>
    </node>
    <node id="CUSTOMER">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Customer entity in the API List ICA Database, used to query details about customers based on email domain and gender, and to retrieve customer-specific information such as allergens and order details</data>
      <data key="d2">c7e00c6a54b81fe33fb8626ede16629e</data>
    </node>
    <node id="ORDER">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Order entity in the API List ICA Database, used to query details about customer orders such as order date, bill amount, and customer feedback</data>
      <data key="d2">c7e00c6a54b81fe33fb8626ede16629e</data>
    </node>
    <node id="INVENTORY">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Inventory entity in the API List ICA Database, used to query details about products related to a specific brand
INVENTORY is a part of the API URL used to query product details</data>
      <data key="d2">3aba43df2ad0c03781e71b4cce5b9e20,c7e00c6a54b81fe33fb8626ede16629e</data>
    </node>
    <node id="ALLERGEN">
      <data key="d0">EVENT</data>
      <data key="d1">Allergen details provided by the API List ICA Database, including information about allergens that customers are allergic to</data>
      <data key="d2">c7e00c6a54b81fe33fb8626ede16629e</data>
    </node>
    <node id="RECIPE">
      <data key="d0" />
      <data key="d1" />
      <data key="d2">c7e00c6a54b81fe33fb8626ede16629e</data>
    </node>
    <node id="DCPONAZURE-ENTITY-API03.AZUREWEBSITES.NET">
